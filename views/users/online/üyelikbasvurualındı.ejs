<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Başvuru Alındı</title>

<!-- W3.CSS, Font Awesome, Bootstrap -->
<link rel="stylesheet" href="https://www.w3schools.com/w3css/5/w3.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lato:400,700,900">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<style>
html, body {
  height: 100%;
  margin: 0;
  font-family: "Lato", sans-serif;
  display: flex;
  flex-direction: column;
  background: #f4f6f9;
}

/* Navbar boşluk */
.nav-space { height: 65px; }

/* Başlık alanı */
.page-header {
  background: linear-gradient(135deg, #8b0000, #dc3545);
  color: white;
  padding: 60px 20px;
  text-align: center;
}
.page-header h1 {
  font-weight: 900;
  font-size: 2.5rem;
}
.page-header p {
  opacity: 0.9;
  font-size: 1.2rem;
  margin-top: 10px;
}

/* Başarı kartı */
.success-card {
  background: white;
  max-width: 700px;
  margin: 40px auto;
  padding: 40px 30px;
  border-radius: 1rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  text-align: center;
}

.success-card i {
  font-size: 4rem;
  color: #28a745;
  margin-bottom: 20px;
}

.success-card h2 {
  font-weight: 700;
  margin-bottom: 15px;
  color: #333;
}

.success-card p {
  font-size: 1.1rem;
  color: #555;
}

/* Footer her zaman en altta */
footer {
  margin-top: auto;
}
</style>
<%- include('../partials/analytic') %>
</head>

<body>

<!-- Navbar -->
<div class="w3-top">
  <%- include('../../partials/nav') %>
</div>

<div class="nav-space"></div>

<!-- Başlık -->
<div class="page-header">
  <h1>Başvurunuz Alınmıştır</h1>
  <p>Üyelik başvurunuz başarıyla tarafımıza iletilmiştir.</p>
</div>

<!-- Başarı mesajı -->
<div class="success-card">
  <i class="fa fa-check-circle"></i>
  <h2>Teşekkürler!</h2>
  <p>
    Başvurunuz başarıyla gönderildi.<br>
    Üyelik işlemleri için tarafınızla whatsapp üzerinden iletişim kurulacaktır.
  </p>
</div>

<!-- Footer -->
<footer class="w3-container w3-red w3-center w3-padding-32">
  <%- include("../../partials/footer") %>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>