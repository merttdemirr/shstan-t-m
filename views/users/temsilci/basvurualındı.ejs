<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>İş Yeri Temsilcisi Başvuru</title>

<link rel="stylesheet" href="https://www.w3schools.com/w3css/5/w3.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lato:400,700,900">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<style>
body {
  font-family: "Lato", sans-serif;
  background: #f4f6f9;
  margin: 0;
}

/* Navbar boşluk */
.nav-space {
  height: 65px;
}

/* ÜST BAŞLIK ALANI */
.page-header {
  background: linear-gradient(135deg, #8b0000, #dc3545);
  color: white;
  padding: 70px 20px;
  text-align: center;
}

.page-header h1 {
  font-weight: 900;
}

.page-header p {
  opacity: 0.95;
}

/* FORM KART */
.form-card {
  background: white;
  padding: 50px;
  border-radius: 1.5rem;
  box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  margin-top: -40px;
  margin-bottom: 60px;
}

/* Başarı mesajı */
.alert-success {
  background: #28a745;
  color: white;
  font-weight: 700;
  border-radius: 0.5rem;
  padding: 15px;
  margin-bottom: 30px;
  text-align: center;
}

/* Buton */
.btn-send {
  background: #dc3545;
  color: white;
  font-weight: 700;
  padding: 12px;
  border-radius: 50px;
}

.btn-send:hover {
  background: #b52a37;
}
</style>
</head>

<body>

<div class="w3-top">
  <%- include('../../partials/nav') %>
</div>

<div class="nav-space"></div>

<!-- ÜST KIRMIZI BAŞLIK -->
<div class="page-header">
  <h1><i class="fa fa-id-badge"></i> İş Yeri Temsilcisi Başvurusu</h1>
  <p>
    Sendikamızın iş yerlerinde güçlü temsil edilmesi için başvurunuzu yapabilirsiniz.
  </p>
</div>

<div class="container" style="max-width:800px;">
  
  <% if (typeof successMessage !== "undefined") { %>
    <div class="alert-success">
      <i class="fa fa-check-circle"></i> <%= successMessage %>
    </div>
  <% } %>

  <div class="form-card">

    <form action="/temsilci/basvuru" method="POST">

      <div class="row">

        <div class="col-md-6 mb-4">
          <label class="form-label fw-bold">Ad Soyad</label>
          <input type="text" name="adsoyad" class="form-control" required>
        </div>

        <div class="col-md-6 mb-4">
          <label class="form-label fw-bold">TC Kimlik No</label>
          <input type="text" name="tc" class="form-control" maxlength="11" required>
        </div>

        <div class="col-md-6 mb-4">
          <label class="form-label fw-bold">Telefon</label>
          <input type="text" name="telefon" class="form-control" required>
        </div>

        <div class="col-md-6 mb-4">
          <label class="form-label fw-bold">E-Posta</label>
          <input type="email" name="email" class="form-control" required>
        </div>

        <div class="col-md-6 mb-4">
          <label class="form-label fw-bold">Görev Yaptığı İl</label>
          <input type="text" name="il" class="form-control" required>
        </div>

        <div class="col-md-6 mb-4">
          <label class="form-label fw-bold">Kurum / Birim</label>
          <input type="text" name="kurum" class="form-control" required>
        </div>

        <div class="col-12 mb-4">
          <label class="form-label fw-bold">Neden Temsilci Olmak İstiyorsunuz?</label>
          <textarea name="aciklama" class="form-control" rows="4"></textarea>
        </div>

      </div>

      <button type="submit" class="btn btn-send w-100">
        <i class="fa fa-paper-plane"></i> Başvuruyu Gönder
      </button>

    </form>

  </div>

</div>

<footer class="w3-container w3-red w3-center w3-padding-32">
  <%- include("../../partials/footer") %>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>