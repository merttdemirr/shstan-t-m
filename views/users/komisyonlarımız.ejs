.coming-soon {
  background: repeating-linear-gradient(
    45deg,
    #f8f9fa,
    #f8f9fa 10px,
    #e9ecef 10px,
    #e9ecef 20px
  );
  border: 2px dashed #adb5bd !important;
  opacity: 0.85;
  position: relative;
}

.coming-soon::after {
  content: "HAZIRLANIYOR";
  position: absolute;
  top: 12px;
  right: -35px;
  background: #ffc107;
  color: #000;
  font-weight: bold;
  padding: 5px 40px;
  transform: rotate(45deg);
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
}

.coming-soon .btn {
  background-color: #6c757d !important;
  pointer-events: none;
}
